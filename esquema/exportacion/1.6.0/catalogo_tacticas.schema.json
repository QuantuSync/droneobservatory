{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:exportacion:1.6.0:catalogo_tacticas",
  "title": "Tácticas y maniobras observadas",
  "description": "Registro estructurado de tácticas con drones (alturas de vuelo, rutas, señuelos, enjambres, nodrizas, control por fibra óptica, vuelo a ras de suelo) que leen el barrido del catálogo vivo y los partes de la capa de guerra: tipo, modelos y países que nombra, primera y última vez, veces y hasta tres frases de ejemplo con su fuente. estado: admitida si alguna fuente es directa (autoridad, inteligencia, análisis) o la confirman dos sitios; candidata si solo la dice la prensa.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tacticas"
  ],
  "properties": {
    "tacticas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "clave",
          "tactica",
          "primera",
          "ultima",
          "veces",
          "estado",
          "ejemplos"
        ],
        "properties": {
          "clave": {
            "type": "string"
          },
          "tactica": {
            "enum": [
              "fibra_optica",
              "enjambre",
              "nodriza",
              "senuelo",
              "ras_de_suelo",
              "altura",
              "ruta"
            ]
          },
          "modelos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "paises": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "primera": {
            "type": "string"
          },
          "ultima": {
            "type": "string"
          },
          "veces": {
            "type": "integer",
            "minimum": 1
          },
          "estado": {
            "enum": [
              "admitida",
              "candidata"
            ]
          },
          "ejemplos": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
