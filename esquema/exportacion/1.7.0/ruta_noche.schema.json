{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:exportacion:1.7.0:ruta_noche",
  "title": "Rutas de una noche",
  "description": "Las franjas de ruta publicadas de una noche sobre Ucrania (proceso/rutas): con NEPTUN, sus pistas; sin NEPTUN, la reconstrucción con los mensajes de seguimiento de la Fuerza Aérea de Ucrania, si pasa la comprobación. Cada tramo con su regla de origen: los extremos de un enlace de la Fuerza Aérea salen de sus mensajes (oficial); el enlace, la franja y lo de NEPTUN son calculados por una regla, con su versión. Desde el formato 1.7.0, el recorrido unido de cada grupo (proceso/rutas/recorridos.py: una línea por rama, de su principio a su final, sin los avisos de región entera), calculado por su regla con su versión.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "noche",
    "fuente",
    "ataques",
    "tramos",
    "procedencia",
    "recorridos"
  ],
  "properties": {
    "noche": {
      "type": "string",
      "format": "date"
    },
    "fuente": {
      "enum": [
        "neptun",
        "fuerza_aerea"
      ]
    },
    "ataques": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "atribucion": {
      "type": "object"
    },
    "incidentes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tramos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grupo",
          "clase",
          "tipo",
          "desde",
          "hasta",
          "precision_km",
          "procedencia"
        ],
        "properties": {
          "grupo": {
            "type": "integer"
          },
          "clase": {
            "enum": [
              "enlace",
              "hacia_destino",
              "desde_lanzamiento",
              "neptun"
            ]
          },
          "tipo": {
            "enum": [
              "ataque",
              "reaccion",
              "reconocimiento"
            ]
          },
          "desde": {
            "type": "object"
          },
          "hasta": {
            "type": "object"
          },
          "precision_km": {
            "type": "number"
          },
          "numero": {
            "type": "object"
          },
          "kmh": {
            "type": "number"
          },
          "pista": {
            "type": "string"
          },
          "confianza": {
            "type": "string"
          },
          "mensajes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "division": {
            "type": "boolean"
          },
          "union": {
            "type": "boolean"
          },
          "procedencia": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "extremos",
              "tramo"
            ],
            "properties": {
              "extremos": {
                "$ref": "#/$defs/origen"
              },
              "tramo": {
                "$ref": "#/$defs/origen"
              }
            }
          }
        }
      }
    },
    "recorridos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grupo",
          "tipo",
          "aparatos",
          "kmh",
          "inicio",
          "fin",
          "precision_km",
          "longitud_km",
          "trozos",
          "division",
          "union",
          "lineas",
          "procedencia"
        ],
        "properties": {
          "grupo": {
            "type": "integer",
            "minimum": 1
          },
          "tipo": {
            "enum": [
              "ataque",
              "reaccion",
              "reconocimiento"
            ]
          },
          "aparatos": {
            "type": [
              "integer",
              "null"
            ]
          },
          "kmh": {
            "type": [
              "number",
              "null"
            ]
          },
          "inicio": {
            "type": [
              "string",
              "null"
            ]
          },
          "fin": {
            "type": [
              "string",
              "null"
            ]
          },
          "precision_km": {
            "type": "object"
          },
          "longitud_km": {
            "type": "number"
          },
          "trozos": {
            "type": "integer"
          },
          "division": {
            "type": "boolean"
          },
          "union": {
            "type": "boolean"
          },
          "confianza": {
            "type": "string"
          },
          "pistas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lineas": {
            "type": "array",
            "items": {
              "type": "array"
            }
          },
          "procedencia": {
            "$ref": "#/$defs/origen"
          }
        }
      }
    },
    "procedencia": {
      "$ref": "#/$defs/origen"
    }
  },
  "$defs": {
    "origen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origen",
        "metodo",
        "fuentes"
      ],
      "properties": {
        "origen": {
          "enum": [
            "oficial",
            "calculado"
          ]
        },
        "metodo": {
          "type": "string",
          "minLength": 1
        },
        "fuentes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
