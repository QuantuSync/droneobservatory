{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:exportacion:1.7.0:contexto_pais",
  "title": "Cifra oficial de contexto de un país",
  "description": "Una cifra agregada oficial de un país (configuracion/cifras_contexto.json): contexto, nunca un incidente ni parte del recuento de incidentes. Lleva su origen por valor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "pais", "periodo", "categoria", "metrica", "valor", "publicador", "enlace", "cita", "comprobado", "procedencia"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "pais": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "periodo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["texto", "inicio", "fin"],
      "properties": {
        "texto": {"type": "string", "minLength": 1},
        "inicio": {"type": "string", "format": "date"},
        "fin": {"type": "string", "format": "date"}
      }
    },
    "categoria": {"type": "string", "minLength": 1},
    "metrica": {"enum": ["avistamientos", "sobrevuelos", "afectaciones", "detecciones", "otra"]},
    "valor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cifra"],
      "properties": {
        "cifra": {"type": "integer", "minimum": 0},
        "texto": {"type": "string", "minLength": 1}
      }
    },
    "publicador": {"type": "string", "minLength": 1},
    "enlace": {"type": "string", "pattern": "^https?://\\S+$"},
    "cita": {"type": "string", "minLength": 1},
    "comprobado": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fecha", "estado", "via"],
      "properties": {
        "fecha": {"type": "string", "format": "date"},
        "estado": {"type": "integer"},
        "via": {"type": "string", "minLength": 1}
      }
    },
    "procedencia": {
      "description": "Origen y método de cada valor: oficial (el documento de la autoridad) u oficial_citado (la cifra de una autoridad citada por un medio); método transcripción (copiada del documento con su frase literal).",
      "type": "object",
      "additionalProperties": false,
      "required": ["valor"],
      "properties": {
        "valor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origen", "metodo", "fuentes"],
          "properties": {
            "origen": {"enum": ["oficial", "oficial_citado"]},
            "metodo": {"const": "transcripcion"},
            "fuentes": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
