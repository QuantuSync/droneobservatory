{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:exportacion:1.9.0:tipo_dron_validacion",
  "title": "Comprobación del tipo de dron",
  "description": "La comprobación del cálculo del tipo de dron (cursor tipo_dron): calibración por tramos de probabilidad y los casos con que se mide. Deducido por regla. El tipo «compatible» de cada incidente va en incidentes.jsonl (tipo_dron.publicado). Desde el formato 1.9.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disponible",
    "comprobacion",
    "procedencia"
  ],
  "properties": {
    "disponible": {
      "type": "boolean"
    },
    "comprobacion": {
      "type": [
        "object",
        "null"
      ]
    },
    "procedencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origen",
        "metodo"
      ],
      "properties": {
        "origen": {
          "const": "deducido"
        },
        "metodo": {
          "type": "string",
          "minLength": 1
        },
        "regla": {
          "type": "string"
        },
        "fuentes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nota": {
          "type": "string"
        },
        "fecha": {
          "type": "string"
        },
        "estimacion": {
          "type": "boolean"
        },
        "radar": {
          "type": "boolean"
        }
      }
    }
  }
}
