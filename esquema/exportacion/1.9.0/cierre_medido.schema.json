{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:exportacion:1.9.0:cierre_medido",
  "title": "Interrupción medida de un aeropuerto",
  "description": "Una interrupción del tráfico de un aeropuerto medida con las trazas de adsb.lol (tabla anomalias_trafico), casada o no con un incidente: el documento tal como está en la base (esquema/eodi/comun.schema.json#/$defs/anomalia_trafico), con su regla. Origen medido; datos ODbL 1.0 de adsb.lol. Desde el formato 1.9.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "anomalia",
    "procedencia",
    "licencia"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "anomalia": {
      "type": "object"
    },
    "procedencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origen",
        "metodo"
      ],
      "properties": {
        "origen": {
          "const": "medido"
        },
        "metodo": {
          "type": "string",
          "minLength": 1
        },
        "regla": {
          "type": "string"
        },
        "fuentes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nota": {
          "type": "string"
        },
        "fecha": {
          "type": "string"
        },
        "estimacion": {
          "type": "boolean"
        },
        "radar": {
          "type": "boolean"
        }
      }
    },
    "licencia": {
      "type": "string",
      "minLength": 1
    }
  }
}
