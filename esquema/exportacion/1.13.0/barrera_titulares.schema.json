{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:exportacion:1.13.0:barrera_titulares",
  "title": "Barrera de titulares",
  "description": "La barrera que retiene un incidente cuya cita no respalda su titular (recogida/barrera.py, proceso/cita_titular.py): su estado (retenidos, resueltos a nivel de país o retirados, y las resoluciones), el veredicto de cada incidente activo y el titular de un artículo fuente que lo respalda cuando la cita no basta. Los respaldos son prensa; el estado y los veredictos, deducidos por regla. Los retirados y demás descartes van en descartes.jsonl. Desde el formato 1.9.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estado",
    "respaldos",
    "veredictos",
    "procedencia"
  ],
  "properties": {
    "estado": {
      "type": "object"
    },
    "respaldos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incidente",
          "fuente_id",
          "medio",
          "enlace",
          "publica"
        ],
        "properties": {
          "incidente": {
            "type": "string"
          },
          "fuente_id": {
            "type": "string"
          },
          "medio": {
            "type": "string"
          },
          "enlace": {
            "type": "string"
          },
          "publica": {
            "type": "boolean"
          },
          "frase_origen": {}
        }
      }
    },
    "veredictos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incidente",
          "respalda",
          "justificado_a_mano"
        ],
        "properties": {
          "incidente": {
            "type": "string"
          },
          "respalda": {
            "type": "boolean"
          },
          "justificado_a_mano": {
            "type": "boolean"
          }
        }
      }
    },
    "procedencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "respaldos",
        "estado",
        "veredictos"
      ],
      "properties": {
        "respaldos": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origen",
            "metodo"
          ],
          "properties": {
            "origen": {
              "const": "prensa"
            },
            "metodo": {
              "type": "string",
              "minLength": 1
            },
            "regla": {
              "type": "string"
            },
            "fuentes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nota": {
              "type": "string"
            },
            "fecha": {
              "type": "string"
            },
            "estimacion": {
              "type": "boolean"
            },
            "radar": {
              "type": "boolean"
            }
          }
        },
        "estado": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origen",
            "metodo"
          ],
          "properties": {
            "origen": {
              "const": "deducido"
            },
            "metodo": {
              "type": "string",
              "minLength": 1
            },
            "regla": {
              "type": "string"
            },
            "fuentes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nota": {
              "type": "string"
            },
            "fecha": {
              "type": "string"
            },
            "estimacion": {
              "type": "boolean"
            },
            "radar": {
              "type": "boolean"
            }
          }
        },
        "veredictos": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origen",
            "metodo"
          ],
          "properties": {
            "origen": {
              "const": "deducido"
            },
            "metodo": {
              "type": "string",
              "minLength": 1
            },
            "regla": {
              "type": "string"
            },
            "fuentes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nota": {
              "type": "string"
            },
            "fecha": {
              "type": "string"
            },
            "estimacion": {
              "type": "boolean"
            },
            "radar": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
