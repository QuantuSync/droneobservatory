{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:exportacion:1.12.0:prevision_validacion",
  "title": "Previsión publicada con su comprobación",
  "description": "El prevision.json que publica el observatorio (esquema urn:eodi:prevision:1.0.0:prevision): por país (Rumanía, Moldavia y los demás que pasan su comprobación) el riesgo de frontera de cada noche y la previsión semanal, con su comprobación sobre los datos pasados, y el registro de lo previsto puntuado con lo que pasó. Deducido por regla; si el servidor no lo tiene, disponible es false. Desde el formato 1.9.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disponible",
    "documento",
    "procedencia"
  ],
  "properties": {
    "disponible": {
      "type": "boolean"
    },
    "documento": {
      "type": [
        "object",
        "null"
      ]
    },
    "procedencia": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origen",
            "metodo"
          ],
          "properties": {
            "origen": {
              "const": "deducido"
            },
            "metodo": {
              "type": "string",
              "minLength": 1
            },
            "regla": {
              "type": "string"
            },
            "fuentes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nota": {
              "type": "string"
            },
            "fecha": {
              "type": "string"
            },
            "estimacion": {
              "type": "boolean"
            },
            "radar": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
