{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:esquema:1.15.0:incidente",
  "title": "Incidente",
  "description": "Ficha de un incidente con drones fuera de la capa de Ucrania. Cada campo declara su visibilidad en x-visibilidad.",
  "x-version": "1.15.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tipo", "estado", "titulo", "tiempo", "lugar", "fuentes", "control"],
  "properties": {
    "id": {"x-visibilidad": "publico", "type": "string", "pattern": "^EODI-\\d{4}-\\d{5}$"},
    "tipo": {
      "x-visibilidad": "publico",
      "description": "Tipo principal. Si hay interrupción de aeropuerto manda ese tipo; es incursión cuando un dron militar o estatal entra desde fuera y lo demuestra una autoridad o una prueba física; sin origen demostrado nunca es incursión.",
      "enum": ["incursion", "interrupcion_aeroportuaria", "sobrevuelo"]
    },
    "estado": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/estado_historial"},
    "titulo": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/titulo"},
    "episodio": {"x-visibilidad": "publico", "type": "string", "pattern": "^EODI-EP-\\d{4}-\\d{4}$"},
    "presencia_dron": {
      "x-visibilidad": "publico",
      "description": "Si la autoridad competente atribuye el suceso a un dron. confirmada: una autoridad competente (gestor aeroportuario, gestor de navegación aérea, policía, fuerzas armadas, ministerio, gobierno, fiscalía, autoridad de aviación civil) actúa o declara atribuyendo el suceso a un dron (un cierre por dron, un aviso de dron que comunica, una intervención por dron); no se piden restos, grabación ni detección por sensor. no_confirmada: la propia autoridad lo deja abierto (posible dron, objeto no identificado, se investiga si era un dron) o ninguna autoridad lo atribuye a un dron y solo lo cuentan la prensa o los testigos. descartada: una autoridad lo niega. Un incidente confirmado o atribuido cuya fuente oficial atribuye el suceso a un dron tiene siempre la presencia confirmada (proceso/validaciones.errores_presencia). El titular dice lo mismo (proceso/titulares.py).",
      "enum": ["confirmada", "no_confirmada", "descartada"]
    },
    "fusionado_en": {
      "x-visibilidad": "interno",
      "description": "Incidente en el que se ha fundido este. No se publica; la fusión se revierte quitando el campo.",
      "type": "string",
      "pattern": "^EODI-\\d{4}-\\d{5}$"
    },
    "origen_demostrado_por": {
      "x-visibilidad": "interno",
      "description": "Qué demuestra la incursión: una autoridad, el rastreo por radar o una prueba física del propio dron. Obligatorio para el tipo incursión.",
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["autoridad", "rastreo", "restos", "explosion", "caida", "derribo", "recuperado"]}
    },
    "pruebas": {
      "x-visibilidad": "interno",
      "description": "Lo que dicen las fuentes del dron y de su entrada, de lo que salen el tipo y la presencia del dron.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dron_estatal", "entrada_exterior", "evidencia"],
      "properties": {
        "dron_estatal": {"x-visibilidad": "interno", "type": "boolean"},
        "entrada_exterior": {"x-visibilidad": "interno", "type": "boolean"},
        "evidencia": {
          "x-visibilidad": "interno",
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["rastreo", "restos", "explosion", "caida", "derribo", "recuperado"]}
        }
      }
    },
    "retirado": {
      "x-visibilidad": "interno",
      "description": "Incidente que deja de publicarse (nada se borra): una ficha nueva dice que no es un incidente o su ubicación no vale.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fecha", "motivo"],
      "properties": {
        "fecha": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/instante"},
        "motivo": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
        "motivo_en": {"x-visibilidad": "interno", "description": "El motivo en inglés, en las retiradas revisadas a mano (recogida/revisados.py).", "type": "string", "minLength": 1}
      }
    },
    "tiempo": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "required": ["inicio"],
      "properties": {
        "inicio": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/instante"},
        "fin": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/instante"},
        "duracion_min": {
          "x-visibilidad": "publico",
          "description": "Derivada de inicio y fin.",
          "type": "integer",
          "minimum": 0
        },
        "origen_inicio": {
          "x-visibilidad": "interno",
          "description": "De dónde sale el día del inicio (proceso/fechas.py). explicita: la frase de la fuente escribe el día («22 de septiembre»); relativa: lo da respecto a la publicación («anoche», «el lunes»), resuelto con la fecha local del medio; oficial: lo da una autoridad en su propio documento (o es el instante de un encuentro de la UKAB); parte: el periodo de un parte; publicacion: ninguna frase escribe el día y la fecha es la de publicación de la nota (precisión aproximada; si la frase daba la hora, se conserva); medido: lo da el tráfico aéreo medido (solo en la exportación: el inicio de un cierre medido o la única interrupción medida en el aeropuerto en las 48 horas antes de la publicación). corregido: la fecha cambió al comprobarla. motivo: la expresión y la publicación con que se resolvió.",
          "type": "object",
          "additionalProperties": false,
          "required": ["tipo"],
          "properties": {
            "tipo": {"x-visibilidad": "interno", "enum": ["explicita", "relativa", "oficial", "parte", "publicacion", "medido"]},
            "fuente_id": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
            "motivo": {"x-visibilidad": "interno", "type": "string", "minLength": 1, "maxLength": 300},
            "corregido": {"x-visibilidad": "interno", "const": true}
          }
        }
      }
    },
    "lugar": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "description": "Dónde ocurrió el suceso. Punto y radio van juntos y solo si el lugar se sitúa a nivel de instalación o de localidad; si solo se sabe el país o la región, no hay punto y el incidente se publica sin mapa.",
      "required": ["pais"],
      "dependentRequired": {"punto": ["radio_km"], "radio_km": ["punto"]},
      "properties": {
        "punto": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/punto"},
        "radio_km": {"x-visibilidad": "publico", "type": "number", "minimum": 0.1, "maximum": 50},
        "pais": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/pais"},
        "localidad": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
        "region": {"x-visibilidad": "publico", "description": "Región de primer nivel del país, tal como la da la fuente.", "type": "string", "minLength": 1},
        "nivel": {"x-visibilidad": "publico", "description": "Nivel al que se sabe el lugar del suceso.", "enum": ["instalacion", "localidad", "region", "pais"]},
        "suceso": {"x-visibilidad": "interno", "description": "Nombre del lugar del suceso tal como lo escribe la fuente.", "type": "string", "minLength": 1},
        "geocodificacion": {"x-visibilidad": "interno", "description": "De dónde sale el punto. frase_origen: el lugar del suceso solo se sabía a nivel de región y una sola instalación o localidad de esa región sale en las frases y los titulares de sus fuentes; oficial: el punto y el radio que da una autoridad en su documento (detalle_oficial).", "enum": ["nomenclator", "candidato", "vocabulario", "localidad", "localidad_pequena", "lugar_nuevo", "gkg", "frase_origen", "oficial"]},
        "nuts2": {"x-visibilidad": "interno", "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{2}$"},
        "fuente_punto": {"x-visibilidad": "publico", "description": "Fuente que da el lugar del suceso cuando el punto lo da una autoridad (geocodificación oficial): su frase lo nombra. La precisión es el nivel y el radio.", "type": "string", "minLength": 1},
        "otros_lugares": {
          "x-visibilidad": "publico",
          "description": "Los demás lugares que nombra la autoridad (restos hallados, daños) cuando el suceso abarca varios. El punto es siempre un lugar donde estuvo o cayó el dron; un daño causado por la respuesta defensiva nunca es el punto: va aquí, con la fuente que lo explica.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nombre"],
            "properties": {
              "nombre": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
              "punto": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/punto"},
              "fuente": {
                "x-visibilidad": "publico",
                "description": "Fuente del incidente cuya frase literal explica qué hubo en ese lugar (por ejemplo, un daño que la autoridad atribuye a la respuesta defensiva y no al dron).",
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "historial": {
          "x-visibilidad": "publico",
          "description": "Puntos anteriores cuando una corrección revisada cambia el punto (recogida/revisados.py): el lugar que había, cuándo se cambió y por qué, en español y en inglés. Nada se borra: el lugar anterior sigue en otros_lugares si la autoridad lo nombra.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fecha", "anterior", "motivo"],
            "properties": {
              "fecha": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/instante"},
              "anterior": {
                "x-visibilidad": "publico",
                "type": "object",
                "additionalProperties": false,
                "required": ["punto", "radio_km"],
                "properties": {
                  "localidad": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
                  "punto": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/punto"},
                  "radio_km": {"x-visibilidad": "publico", "type": "number", "minimum": 0.1, "maximum": 50},
                  "fuente_punto": {"x-visibilidad": "publico", "type": "string", "minLength": 1}
                }
              },
              "motivo": {
                "x-visibilidad": "publico",
                "type": "object",
                "additionalProperties": false,
                "required": ["es", "en"],
                "properties": {
                  "es": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
                  "en": {"x-visibilidad": "publico", "type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "objetivo": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "required": ["categoria"],
      "properties": {
        "categoria": {
          "x-visibilidad": "publico",
          "enum": ["aeropuerto", "base_militar", "puerto", "energia", "presa", "estadio", "industrial", "gubernamental", "otra"]
        },
        "nombre": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
        "oaci": {"x-visibilidad": "publico", "type": "string", "pattern": "^[A-Z]{4}$"},
        "uso": {"x-visibilidad": "publico", "enum": ["civil", "militar", "mixto"]}
      }
    },
    "drones": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numero": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/rango_entero_o_desconocido"},
        "clase": {
          "x-visibilidad": "publico",
          "enum": ["multirrotor_pequeno", "ala_fija", "ataque_largo_alcance", "desconocido"]
        },
        "modelo": {
          "x-visibilidad": "publico",
          "description": "Valor del vocabulario controlado de configuracion/modelos_dron.json.",
          "type": "string",
          "minLength": 1
        },
        "luces": {"x-visibilidad": "interno", "enum": ["si", "no", "desconocido"]},
        "altura_m": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/rango_real_o_desconocido"},
        "velocidad_ms": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/rango_real_o_desconocido"},
        "trayectoria": {
          "x-visibilidad": "interno",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entrada_grados": {"x-visibilidad": "interno", "type": "number", "minimum": 0, "exclusiveMaximum": 360},
            "salida_grados": {"x-visibilidad": "interno", "type": "number", "minimum": 0, "exclusiveMaximum": 360},
            "puntos": {
              "x-visibilidad": "interno",
              "type": "array",
              "items": {"$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/punto"}
            }
          }
        },
        "patron": {"x-visibilidad": "interno", "enum": ["hover", "merodeo", "transito", "enjambre"]}
      }
    },
    "consecuencias": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cierre": {
          "x-visibilidad": "publico",
          "type": "object",
          "additionalProperties": false,
          "required": ["valor"],
          "properties": {
            "valor": {"x-visibilidad": "publico", "enum": ["si", "no", "desconocido"]},
            "minutos": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/rango_entero_o_desconocido"}
          }
        },
        "vuelos_desviados": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/rango_entero_o_desconocido"},
        "vuelos_cancelados": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/rango_entero_o_desconocido"},
        "vuelos_retrasados": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/rango_entero_o_desconocido"},
        "danos": {
          "x-visibilidad": "publico",
          "type": "object",
          "additionalProperties": false,
          "required": ["nivel"],
          "properties": {
            "nivel": {"x-visibilidad": "publico", "enum": ["ninguno", "menores", "graves", "desconocido"]},
            "frase": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/frase_breve"}
          }
        },
        "heridos": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/rango_entero_o_desconocido"},
        "fallecidos": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/rango_entero_o_desconocido"}
      }
    },
    "respuesta": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "medidas": {
          "x-visibilidad": "publico",
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["cierre_espacio_aereo", "patrulla", "cazas", "derribo", "inhibicion", "ninguna_conocida"]}
        },
        "deteccion": {
          "x-visibilidad": "interno",
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["radar", "visual", "piloto", "camara", "ciudadano"]}
        },
        "resultado_contramedidas": {"x-visibilidad": "interno", "enum": ["funciono", "no_funciono", "desconocido"]}
      }
    },
    "atribucion": {
      "x-visibilidad": "publico",
      "description": "Solo con estado atribuido.",
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "autoridad", "fecha"],
      "properties": {
        "actor": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
        "autoridad": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
        "fecha": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/instante"},
        "tipo": {
          "x-visibilidad": "publico",
          "description": "A quién se atribuye: un Estado o una persona (proceso/atribucion.py). Opcional solo para lo guardado antes del esquema 1.10.0; la validación lo exige.",
          "enum": ["estado", "persona"]
        },
        "pais": {
          "x-visibilidad": "publico",
          "description": "El Estado al que se atribuye o la nacionalidad de la persona, solo si la cita de la autoridad la dice expresamente; nunca se deduce del nombre, del lugar ni del idioma.",
          "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/pais"
        }
      }
    },
    "investigacion": {
      "x-visibilidad": "publico",
      "description": "Investigación en curso: lo que una autoridad dice que investiga, examina o comprueba del incidente, con su cita literal (proceso/atribucion.investigaciones). No cambia el estado: examinar una posible relación no es atribuir.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["autoridad", "cita", "fuente_id", "fecha"],
        "properties": {
          "autoridad": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
          "cita": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
          "fuente_id": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
          "fecha": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/instante"}
        }
      }
    },
    "detalle_oficial": {
      "x-visibilidad": "interno",
      "description": "Lo que precisa un registro oficial de detalle (encuentro con aeronave, respuesta parlamentaria, informe de investigación, sentencia) sobre valores públicos del incidente, sin cambiarlos: la hora, el lugar, el número de drones y las medidas según la autoridad. Su origen y sus fuentes, en procedencia.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inicio": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/instante"},
        "punto": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/punto"},
        "radio_km": {"x-visibilidad": "interno", "type": "number", "minimum": 0.1, "maximum": 50},
        "numero": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/rango_entero_o_desconocido"},
        "medidas": {
          "x-visibilidad": "interno",
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["cierre_espacio_aereo", "patrulla", "cazas", "derribo", "inhibicion", "ninguna_conocida"]}
        }
      }
    },
    "encuentros": {
      "x-visibilidad": "interno",
      "description": "Encuentros con aeronave (encuentro.schema.json) que coinciden con el incidente y le aportan sus datos.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^UKAB-\\d{7}$"}
    },
    "ataque": {
      "x-visibilidad": "publico",
      "description": "Ataque ruso contra Ucrania del que forma parte la incursión (proceso/cruces.py): su id, su noche (o su día) con la regla única de las noches (proceso/ataques.jornada) y por qué se enlaza: la fuente lo relaciona con el ataque («fuente») o coincide en fecha y la incursión viene de Ucrania («fecha»). El ataque lista la incursión en sus cruces.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "jornada", "por"],
      "properties": {
        "id": {"x-visibilidad": "publico", "type": "string", "pattern": "^EODI-UA-\\d{4}-\\d{4}$"},
        "jornada": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/jornada"},
        "por": {"x-visibilidad": "publico", "enum": ["fuente", "fecha"]}
      }
    },
    "zona": {
      "x-visibilidad": "publico",
      "description": "Frontera o interior (proceso/zona.py): drones de la guerra que cruzan o caen cerca de la frontera con Ucrania, Rusia o Bielorrusia o en la costa del mar Negro, o drones sobre el interior de Europa. Motivo de la regla que decide y, si hay punto o lugar nombrado, la distancia a esa frontera en km.",
      "type": "object",
      "additionalProperties": false,
      "required": ["grupo", "motivo"],
      "properties": {
        "grupo": {"x-visibilidad": "publico", "enum": ["frontera", "interior"]},
        "motivo": {"x-visibilidad": "publico", "enum": ["ataque", "cerca_de_la_frontera", "costa_mar_negro", "lejos_de_la_frontera", "incursion_en_pais_fronterizo", "pais_dentro_de_la_banda", "sin_lugar"]},
        "distancia_km": {"x-visibilidad": "publico", "type": "integer", "minimum": 0}
      }
    },
    "foco_termico": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/foco_termico"},
    "trafico_aereo": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/trafico_aereo"},
    "condiciones": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.15.0:comun#/$defs/condiciones"},
    "fuentes": {
      "x-visibilidad": "publico",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:eodi:esquema:1.15.0:fuente"}
    },
    "afirmaciones_publicas": {
      "x-visibilidad": "publico",
      "description": "Quién dice qué: el valor de cada campo público según cada fuente pública, con su medio, su código del Almirantazgo y su fecha. Se genera al publicar desde las afirmaciones internas; no se guarda.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["campo", "fuente_id", "medio", "fiabilidad", "credibilidad", "fecha", "valor"],
        "properties": {
          "campo": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
