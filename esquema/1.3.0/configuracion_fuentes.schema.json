{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:esquema:1.3.0:configuracion_fuentes",
  "title": "Configuración de fuentes",
  "description": "Fiabilidad fija por fuente según el código del Almirantazgo.",
  "x-version": "1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version_esquema", "fuentes"],
  "properties": {
    "version_esquema": {"x-visibilidad": "interno", "description": "Versión del esquema con que se escribió: cualquiera de la versión mayor 1 hasta la actual.", "type": "string", "pattern": "^1\\.\\d+\\.\\d+$"},
    "fuentes": {
      "x-visibilidad": "interno",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "medio", "dominios", "fiabilidad", "es_autoridad", "interna_fuera_de_ucrania"],
        "properties": {
          "id": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
          "medio": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
          "dominios": {
            "x-visibilidad": "interno",
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "fiabilidad": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.3.0:comun#/$defs/fiabilidad"},
          "es_autoridad": {
            "x-visibilidad": "interno",
            "description": "Autoridad cuya confirmación o desmentido cambia el estado.",
            "type": "boolean"
          },
          "interna_fuera_de_ucrania": {
            "x-visibilidad": "interno",
            "description": "Solo puede ser pública dentro de la capa de Ucrania (Ministerio de Defensa ruso).",
            "type": "boolean"
          }
        }
      }
    }
  }
}
