{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:esquema:1.2.0:fuente",
  "title": "Fuente",
  "description": "Una nota publicada que respalda datos. Se guarda el hecho, la frase de origen y el enlace, nunca el texto completo. Las fuentes de fiabilidad E o F son internas enteras, y también las marcadas como internas fuera de la capa de Ucrania.",
  "x-version": "1.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "enlace", "medio", "fecha", "idioma", "fiabilidad", "credibilidad", "frase_origen", "replicas", "publica"],
  "properties": {
    "id": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
    "enlace": {"x-visibilidad": "publico", "type": "string", "pattern": "^https?://\\S+$"},
    "medio": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
    "fecha": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.2.0:comun#/$defs/instante"},
    "idioma": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.2.0:comun#/$defs/idioma"},
    "fiabilidad": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.2.0:comun#/$defs/fiabilidad"},
    "credibilidad": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.2.0:comun#/$defs/credibilidad"},
    "frase_origen": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.2.0:comun#/$defs/frase_origen"},
    "replicas": {"x-visibilidad": "publico", "type": "integer", "minimum": 0},
    "campos_respaldados": {
      "x-visibilidad": "interno",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "es_autoridad": {"x-visibilidad": "interno", "type": "boolean"},
    "interna_fuera_de_ucrania": {"x-visibilidad": "interno", "type": "boolean"},
    "publica": {"x-visibilidad": "interno", "type": "boolean"}
  }
}
