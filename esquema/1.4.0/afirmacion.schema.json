{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:esquema:1.4.0:afirmacion",
  "title": "Afirmación",
  "description": "Valor de un campo según una fuente, con la confianza de la extracción. Si dos fuentes discrepan se guardan las dos afirmaciones.",
  "x-version": "1.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["campo", "valor", "fuente_id", "confianza_extraccion"],
  "properties": {
    "campo": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
    "valor": {"x-visibilidad": "interno"},
    "fuente_id": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
    "confianza_extraccion": {"x-visibilidad": "interno", "type": "number", "minimum": 0, "maximum": 1},
    "credibilidad": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.4.0:comun#/$defs/credibilidad"},
    "origen": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.4.0:comun#/$defs/origen"},
    "metodo": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.4.0:comun#/$defs/metodo"}
  }
}
