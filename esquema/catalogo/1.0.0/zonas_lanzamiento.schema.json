{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:catalogo:1.0.0:zonas_lanzamiento",
  "title": "Zonas de lanzamiento de drones de largo alcance",
  "description": "Las zonas de lanzamiento que nombran los partes de la Fuerza Aérea de Ucrania («з напрямків…»), con las raíces con que aparecen en ellos (se busca la raíz dentro del nombre, en minúsculas), su punto con la fuente que lo da literalmente y las fuentes que documentan su uso para lanzar drones. Una zona que es una dirección o un área (sin un punto estable) no tiene punto y no sirve para medir distancias.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "version_esquema", "descripcion", "zonas"],
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "version_esquema": {"const": "1.0.0"},
    "descripcion": {"type": "string", "minLength": 1},
    "zonas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nombre", "raices", "tipo", "punto", "uso"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "nombre": {"type": "string", "minLength": 1},
          "raices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "excluir": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "tipo": {"enum": ["aerodromo", "instalacion_lanzamiento", "poligono", "zona"]},
          "punto": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["lat", "lon", "fuente", "cita"],
                "properties": {
                  "lat": {"type": "number", "minimum": -90, "maximum": 90},
                  "lon": {"type": "number", "minimum": -180, "maximum": 180},
                  "fuente": {"type": "string", "pattern": "^[A-Z]+\\d+$"},
                  "cita": {"type": "string", "minLength": 1},
                  "nota": {"type": "string", "minLength": 1}
                }
              }
            ]
          },
          "uso": {
            "description": "Fuentes que documentan que se lanzan drones desde ahí.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fuente", "cita"],
              "properties": {
                "fuente": {"type": "string", "pattern": "^[A-Z]+\\d+$"},
                "cita": {"type": "string", "minLength": 1},
                "fecha": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
              }
            }
          },
          "notas": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
