{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:catalogo:1.1.0:catalogo_drones",
  "title": "Catálogo de prestaciones de drones",
  "description": "Prestaciones por modelo (un campo numérico puede llevar además textos cualitativos con su fuente, que no dan cifra), cada valor con su fuente (configuracion/catalogo_fuentes.json) y la frase de la fuente que lo da, y las clases de dron que usa el motor de deducción (proceso/deduccion). Las cifras se copian con la unidad de la fuente, sin redondear ni convertir: el código convierte al usarlas. Si dos fuentes discrepan, cada una es una entrada de datos. Un campo sin dato fiable lleva datos vacío y sin_fuente: nunca se rellena. Una entrada con solo min (o solo max) es una cota abierta: «más de 4 h» no da una autonomía máxima. Los modelos derivados (derivado_de) no tienen cifras propias: su envolvente se calcula con la de los modelos de que salen. Una cifra derivada (derivada) la calcula el código con una fórmula física a partir de otras cifras de la misma ficha, que lleva con su campo y su fuente (proceso/deduccion/aceleraciones.py). La versión del catálogo vivo lleva el sufijo +vivo.N: el catálogo de la configuración más los cambios que ha admitido el barrido periódico (recogida/catalogo_vivo.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "version_esquema", "descripcion", "campos", "clases", "modelos"],
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(\\+vivo\\.\\d+)?$"},
    "version_esquema": {"const": "1.1.0"},
    "descripcion": {"type": "string", "minLength": 1},
    "campos": {
      "description": "Cada campo del catálogo con lo que mide y su unidad canónica (numérico) o texto.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["descripcion", "tipo"],
        "properties": {
          "descripcion": {"type": "string", "minLength": 1},
          "tipo": {"enum": ["numero", "texto"]},
          "unidad": {"enum": ["m", "kg", "m/s", "km", "min", "°C", "m2", "°", "m/s2", "n", "s"]}
        }
      }
    },
    "clases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/clase"}
    },
    "modelos": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/modelo"}
    }
  },
  "$defs": {
    "identificador": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "clase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "descripcion", "tipo_aeronave", "propulsion", "tamano", "clase_esquema", "aegis", "equivalencia_aegis"],
      "properties": {
        "id": {"$ref": "#/$defs/identificador"},
        "nombre": {"type": "string", "minLength": 1},
        "descripcion": {"type": "string", "minLength": 1},
        "tipo_aeronave": {"enum": ["multirrotor", "ala_fija", "vtol", "reaccion"]},
        "propulsion": {"enum": ["electrica", "combustion", "reaccion"]},
        "tamano": {
          "description": "Tamaño con que lo describiría un testigo: pequeno (hasta unos 50 cm), mediano (hasta unos 2 m), grande (más).",
          "enum": ["pequeno", "mediano", "grande"]
        },
        "corto_alcance": {
          "description": "Clase de corto alcance para la conclusión de la regla de distancia en Europa («despegue cercano o dron de largo alcance»).",
          "type": "boolean"
        },
        "clase_esquema": {
          "description": "Valor de drones.clase del esquema de la base que le corresponde, o null si ninguno.",
          "enum": ["multirrotor_pequeno", "ala_fija", "ataque_largo_alcance", null]
        },
        "aegis": {
          "description": "Clases de tamaño de AEGIS (size_class) que le corresponden.",
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["mini", "phantom", "inspire"]}
        },
        "equivalencia_aegis": {"enum": ["exacta", "parcial", "sin_equivalente"]},
        "nota": {"type": "string", "minLength": 1}
      }
    },
    "dato": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fuente"],
      "properties": {
        "valor": {"type": "number"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "unidad": {"enum": ["m", "mm", "cm", "kg", "g", "km/h", "m/s", "kn", "mph", "lb", "km", "mi", "min", "h", "°C", "m2", "ft", "°", "m/s2", "n", "s", "ft/min"]},
        "texto": {"type": "string", "minLength": 1},
        "fuente": {"type": "string", "pattern": "^[A-Z]+\\d+$"},
        "cita": {"description": "Frase literal de la fuente que da el valor.", "type": "string", "minLength": 1},
        "nota": {"type": "string", "minLength": 1},
        "derivada": {
          "description": "Cifra calculada por el código con una fórmula física a partir de otras cifras de la ficha (cada una con su campo y su fuente). fuente es la de esas cifras. Una entrada con solo min es una cota inferior: la fórmula no da el máximo.",
          "type": "object",
          "additionalProperties": false,
          "required": ["formula", "datos"],
          "properties": {
            "formula": {"type": "string", "minLength": 1},
            "supuesto": {"type": "string", "minLength": 1},
            "datos": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["campo", "fuente", "valor", "unidad"],
                "properties": {
                  "campo": {"type": "string", "minLength": 1},
                  "fuente": {"type": "string", "pattern": "^[A-Z]+\\d+$"},
                  "valor": {"type": "number"},
                  "unidad": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      },
      "oneOf": [
        {"required": ["texto"], "not": {"anyOf": [{"required": ["valor"]}, {"required": ["min"]}, {"required": ["max"]}, {"required": ["unidad"]}]}},
        {"required": ["valor", "unidad"], "not": {"anyOf": [{"required": ["min"]}, {"required": ["max"]}, {"required": ["texto"]}]}},
        {"required": ["unidad"], "anyOf": [{"required": ["min"]}, {"required": ["max"]}], "not": {"anyOf": [{"required": ["valor"]}, {"required": ["texto"]}]}}
      ]
    },
    "campo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datos", "sin_fuente"],
      "properties": {
        "datos": {"type": "array", "items": {"$ref": "#/$defs/dato"}},
        "sin_fuente": {"type": "boolean"}
      },
      "if": {"properties": {"sin_fuente": {"const": true}}},
      "then": {"properties": {"datos": {"maxItems": 0}}},
      "else": {"properties": {"datos": {"minItems": 1}}}
    },
    "modelo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "otros_nombres", "pais", "fabricante", "tipo_aeronave", "clase"],
      "properties": {
        "id": {"$ref": "#/$defs/identificador"},
        "nombre": {"type": "string", "minLength": 1},
        "otros_nombres": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "pais": {"type": "string", "minLength": 1},
        "fabricante": {"type": "string", "minLength": 1},
        "tipo_aeronave": {"enum": ["multirrotor", "ala_fija", "vtol", "reaccion"]},
        "clase": {"$ref": "#/$defs/identificador"},
        "variante_de": {"description": "Modelo del que es variante; no hereda ninguna cifra.", "$ref": "#/$defs/identificador"},
        "derivado_de": {
          "description": "Referencia genérica: su envolvente es la de estos modelos (mínimo de los mínimos y máximo de los máximos), marcada como derivada.",
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identificador"}
        },
        "campos": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/campo"}
        },
        "nota": {"type": "string", "minLength": 1},
        "vivo": {
          "description": "Modelo o cifras que ha admitido el barrido periódico del catálogo vivo: cuándo entró y con qué fuentes.",
          "type": "object",
          "additionalProperties": false,
          "required": ["alta", "fuentes"],
          "properties": {
            "alta": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "fuentes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z]+\\d+$"}}
          }
        }
      },
      "oneOf": [
        {"required": ["campos"], "not": {"required": ["derivado_de"]}},
        {"required": ["derivado_de"], "not": {"required": ["campos"]}}
      ]
    }
  }
}
