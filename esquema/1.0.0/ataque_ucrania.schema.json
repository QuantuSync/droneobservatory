{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:esquema:1.0.0:ataque_ucrania",
  "title": "Ataque de la capa de Ucrania",
  "description": "Un ataque agregado, normalmente una noche, con el periodo tal como lo declara el parte. La atribución no aplica y el parte oficial cuenta como confirmación.",
  "x-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tipo", "periodo", "sentido", "estado", "fuentes", "control"],
  "properties": {
    "id": {"x-visibilidad": "publico", "type": "string", "pattern": "^EODI-UA-\\d{4}-\\d{4}$"},
    "tipo": {"x-visibilidad": "publico", "const": "ataque_guerra"},
    "periodo": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "required": ["inicio", "fin"],
      "properties": {
        "inicio": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/instante"},
        "fin": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/instante"}
      }
    },
    "sentido": {"x-visibilidad": "publico", "enum": ["RU_UA", "UA_RU"]},
    "estado": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/estado_historial"},
    "lanzados": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shahed_geran": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/rango_entero_o_desconocido"},
        "gerbera_senuelos": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/rango_entero_o_desconocido"},
        "otros": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/rango_entero_o_desconocido"},
        "total": {
          "x-visibilidad": "publico",
          "description": "Total declarado. Los partes suelen dar una sola cifra para varios modelos: entonces cada modelo es un rango y el total es la cifra exacta.",
          "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/rango_entero_o_desconocido"
        }
      }
    },
    "zonas_lanzamiento": {
      "x-visibilidad": "publico",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "derribados": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/rango_entero_o_desconocido"},
    "derribados_categoria": {
      "x-visibilidad": "publico",
      "description": "Qué cuenta la cifra de derribados. 'derribados_o_neutralizados' cuando el parte da una sola cifra para derribados y neutralizados por guerra electrónica ('збито/подавлено'): la web lo muestra así.",
      "enum": ["derribados", "derribados_o_neutralizados"]
    },
    "perdidos_guerra_electronica": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/rango_entero_o_desconocido"},
    "localizaciones_impacto": {
      "x-visibilidad": "publico",
      "description": "Número de localizaciones con impacto que declara el parte, aunque no las nombre.",
      "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/rango_entero_o_desconocido"
    },
    "localizaciones_restos": {
      "x-visibilidad": "publico",
      "description": "Número de localizaciones con caída de restos que declara el parte.",
      "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/rango_entero_o_desconocido"
    },
    "lugares_impacto": {
      "x-visibilidad": "publico",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "lugares_restos": {
      "x-visibilidad": "publico",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "cruces": {
      "x-visibilidad": "publico",
      "description": "Drones que cruzan a otro país.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pais", "numero"],
        "properties": {
          "pais": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/pais"},
          "numero": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/rango_entero_o_desconocido"}
        }
      }
    },
    "horas_llegada": {
      "x-visibilidad": "interno",
      "type": "array",
      "items": {"$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/instante"}
    },
    "duracion_oleada_min": {"x-visibilidad": "interno", "type": "integer", "minimum": 0},
    "proporcion_senuelos": {
      "x-visibilidad": "interno",
      "description": "Derivada: señuelos entre lanzados.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "regiones": {
      "x-visibilidad": "publico",
      "type": "array",
      "items": {"$ref": "urn:eodi:esquema:1.0.0:region_ucrania"}
    },
    "fuentes": {
      "x-visibilidad": "publico",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:eodi:esquema:1.0.0:fuente"}
    },
    "afirmaciones": {
      "x-visibilidad": "interno",
      "type": "array",
      "items": {"$ref": "urn:eodi:esquema:1.0.0:afirmacion"}
    },
    "control": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "required": ["alta", "ultima_actualizacion"],
      "properties": {
        "alta": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/instante"},
        "ultima_actualizacion": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/instante"},
        "motivo_desmentido": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
        "version_extractor": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
        "huella_fuentes": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.0.0:comun#/$defs/huella"}
      }
    }
  }
}
