{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:esquema:1.10.0:estadistica_oficial",
  "title": "Estadística oficial",
  "description": "Una cifra agregada que publica una autoridad: sobrevuelos, avistamientos o afectaciones por drones en un periodo y un ámbito (país, instalación o categoría de instalación). Sale de respuestas de gobiernos en el parlamento y de estadísticas de gestores de navegación aérea y autoridades. Registro interno para AEGIS; sirve para medir el sesgo de cobertura de la prensa. Cada cifra lleva la frase de la que sale.",
  "x-version": "1.10.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "autoridad", "pais_autoridad", "documento", "periodo", "ambito", "metrica", "cifra", "frase", "fuente", "procedencia", "control"],
  "properties": {
    "id": {"x-visibilidad": "interno", "description": "Huella de la autoridad, el documento, el periodo, el ámbito y la métrica: la misma cifra leída dos veces es el mismo registro.", "type": "string", "pattern": "^EST-[0-9a-f]{16}$"},
    "autoridad": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
    "pais_autoridad": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/pais"},
    "documento": {
      "x-visibilidad": "interno",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tipo", "enlace", "fecha"],
      "properties": {
        "id": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
        "tipo": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:documento_oficial#/$defs/tipo"},
        "titulo": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
        "enlace": {"x-visibilidad": "interno", "type": "string", "pattern": "^https?://\\S+$"},
        "fecha": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/fecha"}
      }
    },
    "periodo": {
      "x-visibilidad": "interno",
      "description": "Del primer al último día que cubre la cifra, tal como lo da el documento.",
      "type": "object",
      "additionalProperties": false,
      "required": ["inicio", "fin"],
      "properties": {
        "inicio": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/fecha"},
        "fin": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/fecha"}
      }
    },
    "ambito": {
      "x-visibilidad": "interno",
      "description": "A qué se refiere la cifra: un país entero, una categoría de instalación o una instalación concreta.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pais"],
      "properties": {
        "pais": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/pais"},
        "categoria": {"x-visibilidad": "interno", "enum": ["aeropuerto", "base_militar", "puerto", "energia", "presa", "estadio", "industrial", "gubernamental", "otra"]},
        "instalacion": {"x-visibilidad": "interno", "description": "Nombre de la instalación tal como lo da el documento.", "type": "string", "minLength": 1},
        "oaci": {"x-visibilidad": "interno", "type": "string", "pattern": "^[A-Z]{4}$"}
      }
    },
    "metrica": {
      "x-visibilidad": "interno",
      "description": "Qué se cuenta: avistamientos notificados, sobrevuelos, afectaciones o interrupciones del tráfico aéreo, detecciones por sensores, encuentros con aeronaves, investigaciones abiertas o personas detenidas o denunciadas.",
      "enum": ["avistamientos", "sobrevuelos", "afectaciones", "detecciones", "encuentros", "investigaciones", "detenciones", "otra"]
    },
    "cifra": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/rango_entero"},
    "frase": {"x-visibilidad": "interno", "description": "Frase literal del documento con la cifra.", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/frase_breve"},
    "confianza": {"x-visibilidad": "interno", "description": "Confianza de la extracción, si la dio el extractor.", "type": "number", "minimum": 0, "maximum": 1},
    "fuente": {
      "x-visibilidad": "interno",
      "type": "object",
      "additionalProperties": false,
      "required": ["medio", "fiabilidad", "credibilidad"],
      "properties": {
        "medio": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
        "fiabilidad": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/fiabilidad"},
        "credibilidad": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/credibilidad"},
        "licencia": {"x-visibilidad": "interno", "type": "string", "minLength": 1}
      }
    },
    "procedencia": {
      "x-visibilidad": "interno",
      "description": "Origen (oficial) y método de cada valor, por ruta («cifra»).",
      "type": "object",
      "additionalProperties": {"$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/procedencia"}
    },
    "control": {
      "x-visibilidad": "interno",
      "type": "object",
      "additionalProperties": false,
      "required": ["alta"],
      "properties": {
        "alta": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/instante"},
        "version_extractor": {"x-visibilidad": "interno", "type": "string", "minLength": 1}
      }
    }
  }
}
