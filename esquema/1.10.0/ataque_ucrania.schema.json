{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eodi:esquema:1.10.0:ataque_ucrania",
  "title": "Ataque de la capa de Ucrania",
  "description": "Un ataque agregado, normalmente una noche, con el periodo tal como lo declara el parte. La atribución no aplica y el parte oficial cuenta como confirmación.",
  "x-version": "1.10.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tipo", "periodo", "sentido", "estado", "fuentes", "control"],
  "properties": {
    "id": {"x-visibilidad": "publico", "type": "string", "pattern": "^EODI-UA-\\d{4}-\\d{4}$"},
    "tipo": {"x-visibilidad": "publico", "const": "ataque_guerra"},
    "periodo": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "required": ["inicio", "fin"],
      "properties": {
        "inicio": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/instante"},
        "fin": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/instante"}
      }
    },
    "sentido": {"x-visibilidad": "publico", "enum": ["RU_UA", "UA_RU"]},
    "reivindicacion_de_parte": {
      "x-visibilidad": "publico",
      "description": "Las cifras son lo que dice una de las partes en guerra (Fuerza Aérea de Ucrania o Ministerio de Defensa ruso), sin otra fuente que lo confirme.",
      "const": true
    },
    "estado": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/estado_historial"},
    "lanzados": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shahed_geran": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/rango_entero_o_desconocido"},
        "gerbera_senuelos": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/rango_entero_o_desconocido"},
        "otros": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/rango_entero_o_desconocido"},
        "total": {
          "x-visibilidad": "publico",
          "description": "Total declarado. Los partes suelen dar una sola cifra para varios modelos: entonces cada modelo es un rango y el total es la cifra exacta.",
          "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/rango_entero_o_desconocido"
        }
      }
    },
    "zonas_lanzamiento": {
      "x-visibilidad": "publico",
      "description": "Zonas de lanzamiento con su nombre normalizado (configuracion/zonas_lanzamiento_nombres.json): una por zona, aunque el parte la escriba de otra forma.",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "zonas_lanzamiento_citadas": {
      "x-visibilidad": "interno",
      "description": "Las zonas de lanzamiento tal como las escribe el parte, antes de normalizarlas.",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "tipos_dron": {
      "x-visibilidad": "publico",
      "description": "Tipo de dron cuando el parte lo dice sin modelo: ala_fija («самолетного типа») o multirrotor.",
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["ala_fija", "multirrotor"]}
    },
    "derribados": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/rango_entero_o_desconocido"},
    "derribados_categoria": {
      "x-visibilidad": "publico",
      "description": "Qué cuenta la cifra de derribados. 'derribados_o_neutralizados' cuando el parte da una sola cifra para derribados y neutralizados por guerra electrónica ('збито/подавлено'): la web lo muestra así.",
      "enum": ["derribados", "derribados_o_neutralizados"]
    },
    "perdidos_guerra_electronica": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/rango_entero_o_desconocido"},
    "localizaciones_impacto": {
      "x-visibilidad": "publico",
      "description": "Número de localizaciones con impacto que declara el parte, aunque no las nombre.",
      "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/rango_entero_o_desconocido"
    },
    "localizaciones_restos": {
      "x-visibilidad": "publico",
      "description": "Número de localizaciones con caída de restos que declara el parte.",
      "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/rango_entero_o_desconocido"
    },
    "lugares_impacto": {
      "x-visibilidad": "publico",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "lugares_restos": {
      "x-visibilidad": "publico",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "cruces": {
      "x-visibilidad": "publico",
      "description": "Drones que cruzan a otro país.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pais", "numero"],
        "properties": {
          "pais": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/pais"},
          "numero": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/rango_entero_o_desconocido"}
        }
      }
    },
    "horas_llegada": {
      "x-visibilidad": "interno",
      "type": "array",
      "items": {"$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/instante"}
    },
    "duracion_oleada_min": {"x-visibilidad": "interno", "type": "integer", "minimum": 0},
    "proporcion_senuelos": {
      "x-visibilidad": "interno",
      "description": "Derivada: señuelos entre lanzados.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "regiones": {
      "x-visibilidad": "publico",
      "description": "Regiones afectadas por los drones del ataque.",
      "type": "array",
      "items": {"$ref": "urn:eodi:esquema:1.10.0:region_ucrania"}
    },
    "regiones_misiles": {
      "x-visibilidad": "publico",
      "description": "Regiones que el parte solo cita por los misiles del mismo ataque: no cuentan como afectadas por drones.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/region_iso"}
    },
    "incluido_en": {
      "x-visibilidad": "publico",
      "description": "Parte con el total de un periodo que cubre este tramo: las cifras del tramo ya están en ese total y no se suman.",
      "type": "string",
      "pattern": "^EODI-UA-\\d{4}-\\d{4}$"
    },
    "solapado_con": {
      "x-visibilidad": "publico",
      "description": "Tramo con el que este se solapa sin que ninguno cubra al otro: solo se suma aquel.",
      "type": "string",
      "pattern": "^EODI-UA-\\d{4}-\\d{4}$"
    },
    "condiciones": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/condiciones"},
    "perdida_luz": {
      "x-visibilidad": "publico",
      "description": "Regiones y ciudades afectadas por el ataque que perdieron luz nocturna, medido por satélite (proceso/luces.py). Vive en su propia tabla y se añade al publicar.",
      "type": "array",
      "items": {
        "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/perdida_luz"
      }
    },
    "fuentes": {
      "x-visibilidad": "publico",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:eodi:esquema:1.10.0:fuente"}
    },
    "afirmaciones": {
      "x-visibilidad": "interno",
      "type": "array",
      "items": {"$ref": "urn:eodi:esquema:1.10.0:afirmacion"}
    },
    "restricciones_aeropuertos": {
      "x-visibilidad": "interno",
      "description": "Restricciones temporales de aeropuertos rusos que anunció Rosaviatsia durante el ataque (sentido UA_RU): aeropuertos distintos y horas sumadas de las ya levantadas. Lo calcula la exportación semanal; la base no lo guarda.",
      "type": "object",
      "additionalProperties": false,
      "required": ["aeropuertos", "horas"],
      "properties": {
        "aeropuertos": {"x-visibilidad": "interno", "type": "integer", "minimum": 0},
        "horas": {"x-visibilidad": "interno", "type": "number", "minimum": 0}
      }
    },
    "procedencia": {
      "x-visibilidad": "interno",
      "description": "Origen y método de cada valor del ataque, por campo. Lo calcula la exportación semanal; la base no lo guarda.",
      "type": "object",
      "additionalProperties": {"$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/procedencia"}
    },
    "deduccion": {
      "x-visibilidad": "interno",
      "description": "Clases de dron compatibles, descartadas e indeterminadas según el motor de deducción. Origen deducido; interno. Lo añade la exportación desde la tabla deducciones.",
      "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/deduccion"
    },
    "control": {
      "x-visibilidad": "publico",
      "type": "object",
      "additionalProperties": false,
      "required": ["alta", "ultima_actualizacion"],
      "properties": {
        "alta": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/instante"},
        "ultima_actualizacion": {"x-visibilidad": "publico", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/instante"},
        "motivo_desmentido": {"x-visibilidad": "publico", "type": "string", "minLength": 1},
        "version_extractor": {"x-visibilidad": "interno", "type": "string", "minLength": 1},
        "huella_fuentes": {"x-visibilidad": "interno", "$ref": "urn:eodi:esquema:1.10.0:comun#/$defs/huella"}
      }
    }
  }
}
