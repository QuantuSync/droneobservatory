{
  "name": "droneobservatory-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web de una sola pantalla del European Observatory of Drone Incidents",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "datos": "node scripts/datos.ts",
    "bloqueo": "node scripts/bloqueo.ts",
    "auditoria": "npm audit --audit-level=high",
    "dev": "npm run datos && vite",
    "build": "npm run datos && vite-react-ssg build",
    "servir": "node scripts/servidor-local.ts",
    "lint": "eslint .",
    "typecheck": "npm run datos && tsc --noEmit",
    "test": "npm run datos && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.11.2",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vite-react-ssg": "0.9.2",
    "vitest": "5.0.3",
    "web-vitals": "6.2.2"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
